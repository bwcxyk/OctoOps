# 换行符：仓库内统一 LF，检出也不做 CRLF 转换
# 避免 Windows 上 CRLF 与 gofmt/编辑器保存互相覆盖，造成整文件 diff

# 默认按文本处理并归一化为 LF
* text=auto eol=lf

# 后端（Go、脚本、配置）
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.env  text eol=lf

# 前端
*.vue  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.less text eol=lf
*.scss text eol=lf
*.html text eol=lf

# 文档与工程文件
*.md   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制不做换行转换与 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.exe   binary
*.dll   binary
*.so    binary
