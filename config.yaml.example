# OctoOps 配置模板
# 复制为 config.yaml 并根据实际环境填写。

# OctoOps 平台相关配置
octoops:
  server:
    port: 8080 # 后端服务监听端口
  redis:
    addr: "127.0.0.1:6379" # Redis 地址（必填）
    password: "" # Redis 密码
    db: 0 # Redis DB
    prefix: "octoops:" # Redis key 前缀
  security:
    aes_key: "12345678901234567890123456789012" # 通用AES加密密钥（32字节 AES-256），用于阿里云密钥、邮件密码等敏感信息加解密，请勿随意变更
  auth:
    jwt_secret: "CHANGE_ME" # JWT签名密钥，生产环境请使用强密钥

# PostgreSQL 数据库配置
postgres:
  host: 127.0.0.1  # 数据库主机地址
  user: your-db-user  # 数据库用户名
  password: your-db-password  # 数据库密码
  dbname: octoops  # 数据库名
  port: 5432  # 端口，PostgreSQL 默认 5432
  sslmode: disable  # 是否启用 SSL 连接，常用 disable
  timezone: Asia/Shanghai  # 数据库时区

# SeaTunnel 服务相关配置
seatunnel:
  base_url: "http://your-seatunnel-url"  # SeaTunnel API 服务地址
  request_timeout: 5  # 调用 SeaTunnel 接口的超时时间（秒），不填默认 5
